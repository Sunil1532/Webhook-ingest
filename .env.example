HTTP_ADDR=:8080
DATABASE_URL=postgres://webhook:webhook@localhost:5432/webhook?sslmode=disable
REDIS_ADDR=localhost:6379
DB_MAX_CONNS=20

# Host ports published by docker compose. Override these if you already run
# Postgres or Redis locally — then point DATABASE_URL / REDIS_ADDR at them too.
APP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
